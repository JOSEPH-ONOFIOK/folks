# Deployed Folks contract. The mint page refuses to mint without this.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x...

# Robinhood Chain. The page blocks minting on any other network.
# Mainnet values below; for testnet use 46630,
# https://rpc.testnet.chain.robinhood.com and
# https://explorer.testnet.chain.robinhood.com
#
# The public RPC is rate limited. Point this at an Alchemy endpoint before
# the mint, or a busy sale will start failing reads.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER=https://robinhoodchain.blockscout.com
NEXT_PUBLIC_SITE_URL=https://thefolks.xyz
