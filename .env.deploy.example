# Deployment only. Never commit the real file.
#
# Robinhood Chain is an Arbitrum Orbit L2. Verified against
# docs.robinhood.com/chain/connecting and by calling both endpoints.
#   mainnet  chain 4663   https://rpc.mainnet.chain.robinhood.com
#   testnet  chain 46630  https://rpc.testnet.chain.robinhood.com
#
# Deploy to testnet first. The public RPCs are rate limited, so use an
# Alchemy endpoint for the live site on mint day.
DEPLOY_RPC_URL=https://rpc.testnet.chain.robinhood.com
DEPLOY_PRIVATE_KEY=0x...        # deployer key, needs gas on the target chain
# Controls the contract after deploy: opens trading, sets prices and times,
# team mints, withdraws. Defaults to the Folks owner wallet.
OWNER_ADDRESS=0x9EC2C380297945e5db978319fCD6155cfB384BAB
# Where the platform fee is sent. Blank follows OWNER_ADDRESS, so the fee
# and the sale proceeds both land with the owner.
FEE_RECIPIENT=

FOLKLIST_PRICE=0
PUBLIC_PRICE=0.0002
PLATFORM_FEE=0.00004
BASE_URI=ipfs://.../
