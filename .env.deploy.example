# Deployment only. Never commit the real file.
DEPLOY_RPC_URL=https://rpc.robinhood-chain.example
DEPLOY_PRIVATE_KEY=0x...        # deployer key, needs gas on the target chain
OWNER_ADDRESS=                  # defaults to the deployer if blank
# Where the platform fee is sent. Leave blank to use the deployer, which
# puts both the fee and the sale proceeds in the same place.
FEE_RECIPIENT=

FOLKLIST_PRICE=0
PUBLIC_PRICE=0.0002
PLATFORM_FEE=0.00004
BASE_URI=ipfs://.../
